# Copy to .env for Docker Compose. These credentials are development-only.
POSTGRES_DB=orion
POSTGRES_USER=orion_admin
POSTGRES_PASSWORD=orion_admin_dev
DB_READER_USER=orion_reader
DB_READER_PASSWORD=orion_reader_dev

# The API container reaches a local Ollama or LM Studio OpenAI-compatible endpoint.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=local-only
LLM_MODEL=qwen2.5:3b

# Settings for running Python directly on the host.
DATABASE_ADMIN_URL=postgresql+psycopg://orion_admin:orion_admin_dev@localhost:5432/orion
DATABASE_URL=postgresql+psycopg://orion_reader:orion_reader_dev@localhost:5432/orion
MCP_SERVER_URL=http://localhost:8000/mcp
MAX_HISTORY_MESSAGES=20
MAX_TOOL_ROUNDS=4
MCP_DISCOVERY_ATTEMPTS=30
MCP_DISCOVERY_RETRY_SECONDS=1.0
